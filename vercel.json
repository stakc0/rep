{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/launch", "destination": "/launch.html" },
    { "source": "/docs", "destination": "/docs.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
