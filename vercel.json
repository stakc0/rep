{
  "cleanUrls": true,
  "outputDirectory": ".",
  "routes": [
    { "src": "/token(?:/.*)?", "dest": "/token.html" },
    { "src": "/launch", "dest": "/launch.html" },
    { "src": "/docs", "dest": "/docs.html" },
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "/api/[...path].js" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
