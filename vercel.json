{
  "cleanUrls": true,
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "^/([1-9A-HJ-NP-Za-km-z]{32,44})$",
      "destination": "/token?m=$1"
    },
    {
      "source": "/token",
      "destination": "/token.html"
    },
    {
      "source": "/token/:path*",
      "destination": "/api/token/:path*"
    },
    {
      "source": "/launch",
      "destination": "/launch.html"
    },
    {
      "source": "/docs",
      "destination": "/docs.html"
    },
    {
      "source": "/analytics",
      "destination": "/analytics.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
